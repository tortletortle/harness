@app.post("/api/plan/{plan_id}/execute", dependencies=[Depends(require_token)])
async def execute_plan(plan_id: str):
    """执行计划"""
    try:
        if state.current_execution:
            raise HTTPException(status_code=400, detail="已有任务在执行中")
        
        plan = state.database.get_plan(plan_id)
        if not plan:
            raise HTTPException(status_code=404, detail="执行计划不存在")
        
        state.current_execution = plan_id
        
        # 在后台执行
        asyncio.create_task(execute_plan_background(plan))
        
        return {
            "success": True,
            "message": "执行已开始"
        }
        
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

async def execute_plan_background(plan):
    """后台执行计划"""
    # 添加文件日志用于调试
    import sys
    log_file = Path("execution_debug.log")
    
    def debug_log(msg):
        with open(log_file, "a", encoding="utf-8") as f:
            f.write(f"{datetime.now().isoformat()} - {msg}\n")
            f.flush()
        print(f"[DEBUG] {msg}", file=sys.stderr)
    
    try:
        debug_log(f"execute_plan_background STARTED for plan {plan.plan_id}")
        await broadcast_log(f"开始执行计划: {plan.plan_id}", "info")

        for segment in plan.segments:
            debug_log(f"Processing segment with {len(segment.steps)} steps")
            for step in segment.steps:
                debug_log(f"Step {step.step_id}: {step.description[:30]}...")
                await broadcast_log(f"执行步骤 {step.step_id}: {step.description[:50]}...")

                # 更新状态为 RUNNING
                debug_log(f"Updating step {step.step_id} to RUNNING")
                state.database.update_step(
                    step_id=str(step.step_id),
                    status="Running",  # 修正：使用 StepStatus.RUNNING 的值 "Running"
                    executed_at=datetime.now()
                )

                # 执行步骤
                debug_log(f"Executing step {step.step_id}")
                result = await state.executor.execute_step(step)
                debug_log(f"Step {step.step_id} result: success={result.get('success')}")

                # 根据结果更新状态
                if result.get("success"):
                    await broadcast_log(f"[OK] 步骤 {step.step_id} 完成", "success")
                    state.database.update_step(
                        step_id=str(step.step_id),
                        status="Success",  # 修正：使用 StepStatus.SUCCESS 的值
                        outputs=result.get("output"),
                        executed_at=datetime.now()
                    )
                    debug_log(f"Step {step.step_id} marked as Success")
                else:
                    error = result.get("error", "未知错误")
                    await broadcast_log(f"[ERROR] 步骤 {step.step_id} 失败: {error}", "error")
                    state.database.update_step(
                        step_id=str(step.step_id),
                        status="Failed",  # 修正：使用 StepStatus.FAILED 的值 "Failed"
                        outputs={"error": error},
                        executed_at=datetime.now()
                    )
                    debug_log(f"Step {step.step_id} marked as Failed: {error}")
                    break

        await broadcast_log(f"计划执行完成: {plan.plan_id}", "success")
        debug_log(f"Plan {plan.plan_id} execution COMPLETED")

    except Exception as e:
        debug_log(f"EXCEPTION in execute_plan_background: {e}")
        import traceback
        debug_log(f"Traceback: {traceback.format_exc()}")
        await broadcast_log(f"执行失败: {str(e)}", "error")
    finally:
        state.current_execution = None
        debug_log(f"execute_plan_background FINISHED for plan {plan.plan_id}")

@app.get("/api/tools", dependencies=[Depends(require_token)])
async def get_tools():
    """获取工具列表"""
    try:
        tools = state.tool_registry.list_tools()
        # Format tools for frontend
        formatted_tools = []
        for tool in tools:
            # Extract capabilities as a list of instruction names
            capabilities = []
            if "capabilities" in tool and "instructions" in tool.get("capabilities", {}):
                capabilities = [inst["name"] for inst in tool["capabilities"]["instructions"]]
            
            formatted_tools.append({
                "tool_id": tool.get("tool_id", ""),
                "name": tool.get("name", ""),
                "description": tool.get("description", ""),
                "category": tool.get("category", "other"),
                "capabilities": capabilities,
                "requirements": []  # Can be populated from dependencies if needed
            })
        
        return {
            "success": True,
            "tools": formatted_tools
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

