# 环境变量示例
# 复制此文件为 .env 并填入真实值

# Anthropic API
ANTHROPIC_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# EAS OpenAI-compatible provider credentials (runtime only)
EAS_LLM_API_KEY_STEPFUN=
EAS_LLM_BASE_URL_STEPFUN=https://llm.longai.vip

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eas
DB_USER=eas_user
DB_PASSWORD=

# 配置文件路径
EAS_CONFIG_PATH=config/models.yaml

# 日志级别
LOG_LEVEL=info

# 开发模式
DEV_MODE=true

# 超级搜索工具（可选：配置后自动启用对应 API 引擎；不配置也能用 DuckDuckGo/Bing）
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
