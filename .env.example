# 环境变量示例
# 复制此文件为 .env 并填入真实值

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eas
DB_USER=eas_user
DB_PASSWORD=your_password_here

# 配置文件路径
EAS_CONFIG_PATH=config/models.yaml

# 日志级别
LOG_LEVEL=info

# 开发模式
DEV_MODE=true

# 超级搜索工具（可选：配置后自动启用对应 API 引擎；不配置也能用 DuckDuckGo/Bing）
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
