//! UI 侧状态与 reducer。
//!
//! 权威数据路径（与 Web 端同构，设计稿 §20.3）：
//! - plan_update 推送只应用 version 严格递增的事件（版本围栏，§16.4）
//! - 30s REST 兜底全量拉取作为权威校准
//! - 日志环形缓冲，防止长时间运行撑爆内存

use crate::types::{
    parse_plan_status, parse_step_status, ApprovalRequest, ApprovalResolved, AuditLogEntry, Design,
    DesignApprovalResponse, PlanDetail, PlanStatus, PlanSummary, RollbackResult, StepStatus,
};
use std::collections::{HashMap, HashSet};

const LOG_CAP: usize = 1000;

#[derive(Debug, Clone, PartialEq)]
pub struct LogLine {
    pub level: String,
    pub message: String,
}

/// 选中计划的运行时视图：detail + 实时推送合并出的步骤状态
#[derive(Debug, Clone)]
pub struct SelectedPlan {
    pub plan_id: String,
    pub status: PlanStatus,
    /// step_id → 实时状态（优先于 detail 内嵌的静态状态）
    pub live_status: HashMap<String, StepStatus>,
    pub detail: PlanDetail,
    /// 已应用的 plan_update 版本（版本围栏）
    pub last_version: u64,
    /// 是否已经收到过该计划的 WS 运行态；用于避免 REST 刷新覆盖无版本事件。
    has_ws_status: bool,
}

impl SelectedPlan {
    pub fn step_status(&self, step_id: &str, fallback: &str) -> StepStatus {
        self.live_status
            .get(step_id)
            .copied()
            .unwrap_or_else(|| parse_step_status(fallback))
    }

    /// 步骤状态变更次数（Progress = 成功/跳过比例；回滚不算完成）
    pub fn progress(&self) -> (usize, usize) {
        let total = self.detail.steps.len();
        let done = self
            .detail
            .steps
            .iter()
            .filter(|s| {
                matches!(
                    self.step_status(&s.step_id, &s.status),
                    StepStatus::Success | StepStatus::Skipped
                )
            })
            .count();
        (done, total)
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum GuiMode {
    Input,
    Review,
    Plan,
}

#[derive(Debug)]
pub struct GuiState {
    pub token: String,
    pub mode: GuiMode,
    /// Design rows are kept separately from execution plans so review history
    /// cannot disturb the stage-2 plan/approval state.
    pub designs: Vec<Design>,
    pub current_design: Option<Design>,
    pub input_text: String,
    pub design_loading: bool,
    pub design_action_in_flight: bool,
    pub design_error: Option<String>,
    pub feedback_text: String,
    pub connected: bool,
    pub last_ws_error: Option<String>,
    pub service_status: Option<crate::types::ServiceStatus>,
    pub plans: Vec<PlanSummary>,
    pub selected: Option<SelectedPlan>,
    /// 每个计划最后观察到的 WS 版本，计划切换后仍可防止旧 REST detail 清零版本。
    pub last_versions: HashMap<String, u64>,
    pub logs: Vec<LogLine>,
    pub notice: Option<String>,

    /// 当前仍待人工处理的工具调用审批。
    pub pending_approvals: Vec<ApprovalRequest>,
    pub approvals_loading: bool,
    pub approvals_error: Option<String>,
    /// 每个审批请求单独记录，避免一个请求阻塞整个审批队列。
    pub approval_in_flight: HashSet<String>,
    pub approval_comments: HashMap<String, String>,
    /// Resolution tombstones prevent a delayed polling snapshot reopening a card.
    pub(crate) resolved_approval_ids: HashSet<String>,

    /// 审计面板状态.搜索在本地执行，网络层只负责拉取 limit 条原始记录。
    pub audit_logs: Vec<AuditLogEntry>,
    pub audit_loading: bool,
    pub audit_error: Option<String>,
    pub audit_search: String,
    pub audit_limit: u32,
    pub audit_visible: bool,

    /// 回滚确认/请求状态。一次只能提交一个回滚，但不会影响审批按钮。
    pub rollback_confirmation: Option<(String, String)>,
    pub rollback_in_flight: Option<(String, String)>,
    pub rollback_error: Option<String>,
    pub rollback_result: Option<RollbackResult>,
}

impl Default for GuiState {
    fn default() -> Self {
        Self {
            token: String::new(),
            mode: GuiMode::Input,
            designs: Vec::new(),
            current_design: None,
            input_text: String::new(),
            design_loading: false,
            design_action_in_flight: false,
            design_error: None,
            feedback_text: String::new(),
            connected: false,
            last_ws_error: None,
            service_status: None,
            plans: Vec::new(),
            selected: None,
            last_versions: HashMap::new(),
            logs: Vec::new(),
            notice: None,
            pending_approvals: Vec::new(),
            approvals_loading: false,
            approvals_error: None,
            approval_in_flight: HashSet::new(),
            approval_comments: HashMap::new(),
            resolved_approval_ids: HashSet::new(),
            audit_logs: Vec::new(),
            audit_loading: false,
            audit_error: None,
            audit_search: String::new(),
            audit_limit: 100,
            audit_visible: false,
            rollback_confirmation: None,
            rollback_in_flight: None,
            rollback_error: None,
            rollback_result: None,
        }
    }
}

impl GuiState {
    pub fn push_log(&mut self, level: &str, message: String) {
        self.logs.push(LogLine {
            level: level.to_string(),
            message,
        });
        if self.logs.len() > LOG_CAP {
            let overflow = self.logs.len() - LOG_CAP;
            self.logs.drain(0..overflow);
        }
    }

    pub fn set_notice(&mut self, msg: impl Into<String>) {
        self.notice = Some(msg.into());
    }

    pub fn set_designs(&mut self, designs: Vec<Design>) {
        self.designs = designs;
    }

    pub fn begin_design_generation(&mut self) -> bool {
        if self.design_loading || self.input_text.trim().is_empty() {
            return false;
        }
        self.design_loading = true;
        self.design_error = None;
        true
    }

    pub fn design_generated(&mut self, design: Design) {
        self.design_loading = false;
        self.design_action_in_flight = false;
        self.design_error = None;
        self.input_text = design.user_request.clone();
        self.current_design = Some(design.clone());
        if let Some(existing) = self
            .designs
            .iter_mut()
            .find(|existing| existing.design_id == design.design_id)
        {
            *existing = design;
        } else {
            self.designs.insert(0, design);
        }
        self.mode = GuiMode::Review;
    }

    pub fn design_generation_failed(&mut self, error: String) {
        self.design_loading = false;
        self.design_error = Some(error);
    }

    pub fn begin_design_action(&mut self) -> bool {
        if self.design_action_in_flight || self.current_design.is_none() {
            return false;
        }
        self.design_action_in_flight = true;
        self.design_error = None;
        true
    }

    pub fn finish_design_action(&mut self, result: Result<DesignApprovalResponse, String>) {
        self.design_action_in_flight = false;
        match result {
            Ok(DesignApprovalResponse::Approved { plan }) => {
                self.design_error = None;
                self.set_plan_detail(plan);
                self.current_design = None;
                self.feedback_text.clear();
                self.mode = GuiMode::Plan;
            }
            Ok(DesignApprovalResponse::Revised { design }) => {
                self.design_error = None;
                self.design_generated(design);
                self.feedback_text.clear();
                self.mode = GuiMode::Review;
            }
            Ok(DesignApprovalResponse::Rejected { message }) => {
                self.design_error = None;
                self.current_design = None;
                self.feedback_text.clear();
                self.mode = GuiMode::Input;
                self.set_notice(message);
            }
            Err(error) => {
                self.design_error = Some(error);
            }
        }
    }

    /// Rejecting without feedback is intentionally a UI validation failure;
    /// it never reaches the backend's ordinary-rejection branch.
    pub fn trimmed_feedback(&self) -> Option<String> {
        let feedback = self.feedback_text.trim();
        (!feedback.is_empty()).then(|| feedback.to_string())
    }

    pub fn set_approval_comment(&mut self, approval_id: &str, comment: String) {
        self.approval_comments
            .insert(approval_id.to_string(), comment);
    }

    pub fn approval_comment(&self, approval_id: &str) -> &str {
        self.approval_comments
            .get(approval_id)
            .map(String::as_str)
            .unwrap_or_default()
    }

    /// Replace the polling snapshot without dropping cards that are currently being resolved.
    pub fn set_pending_approvals(&mut self, approvals: Vec<ApprovalRequest>) {
        let mut by_id: HashMap<String, ApprovalRequest> = approvals
            .into_iter()
            .filter(|approval| !self.resolved_approval_ids.contains(&approval.approval_id))
            .map(|approval| (approval.approval_id.clone(), approval))
            .collect();
        for existing in &self.pending_approvals {
            if self.approval_in_flight.contains(&existing.approval_id) {
                by_id
                    .entry(existing.approval_id.clone())
                    .or_insert_with(|| existing.clone());
            }
        }
        self.pending_approvals = by_id.into_values().collect();
        self.pending_approvals
            .sort_by(|a, b| a.created_at.cmp(&b.created_at));
        self.approvals_error = None;
    }

    /// Apply a WS approval request, de-duplicating replayed polling/WS notifications.
    pub fn apply_approval_request(&mut self, approval: ApprovalRequest) -> bool {
        if self.resolved_approval_ids.contains(&approval.approval_id)
            || self
                .pending_approvals
                .iter()
                .any(|current| current.approval_id == approval.approval_id)
        {
            return false;
        }
        self.pending_approvals.push(approval);
        self.pending_approvals
            .sort_by(|a, b| a.created_at.cmp(&b.created_at));
        true
    }

    /// Remove only the approval named by the resolution event.
    pub fn apply_approval_resolved(&mut self, resolved: &ApprovalResolved) -> bool {
        let before = self.pending_approvals.len();
        self.pending_approvals
            .retain(|approval| approval.approval_id != resolved.approval_id);
        self.resolved_approval_ids
            .insert(resolved.approval_id.clone());
        self.approval_in_flight.remove(&resolved.approval_id);
        self.approval_comments.remove(&resolved.approval_id);
        before != self.pending_approvals.len()
    }

    pub fn begin_approval(&mut self, approval_id: &str) -> bool {
        if self.approval_in_flight.contains(approval_id) {
            return false;
        }
        if self
            .pending_approvals
            .iter()
            .any(|approval| approval.approval_id == approval_id)
        {
            self.approval_in_flight.insert(approval_id.to_string())
        } else {
            false
        }
    }

    /// A failed REST action clears its spinner but deliberately keeps its card.
    pub fn finish_approval(&mut self, approval_id: &str, result: Result<ApprovalResolved, String>) {
        self.approval_in_flight.remove(approval_id);
        match result {
            Ok(resolved) if resolved.approval_id == approval_id => {
                self.apply_approval_resolved(&resolved);
            }
            Ok(_) => {
                self.approvals_error = Some("审批响应 ID 与请求不匹配".to_string());
            }
            Err(error) => {
                self.approvals_error = Some(error);
            }
        }
    }

    pub fn filtered_audit_logs(&self) -> Vec<&AuditLogEntry> {
        let needle = self.audit_search.trim().to_lowercase();
        if needle.is_empty() {
            return self.audit_logs.iter().collect();
        }
        self.audit_logs
            .iter()
            .filter(|log| {
                [
                    Some(log.audit_id.to_string()),
                    Some(log.timestamp.clone()),
                    Some(log.plan_id.clone()),
                    log.step_id.clone(),
                    log.tool_id.clone(),
                    log.instruction.clone(),
                    log.inputs.clone(),
                    log.block_reason.clone(),
                    log.actor.clone(),
                ]
                .into_iter()
                .flatten()
                .any(|value| value.to_lowercase().contains(&needle))
            })
            .collect()
    }

    pub fn request_rollback(&mut self, plan_id: String, step_id: String) {
        self.rollback_confirmation = Some((plan_id, step_id));
        self.rollback_error = None;
    }

    pub fn cancel_rollback(&mut self) {
        self.rollback_confirmation = None;
    }

    pub fn begin_rollback(&mut self, plan_id: &str, step_id: &str) -> bool {
        if self.rollback_in_flight.is_some() {
            return false;
        }
        self.rollback_confirmation = None;
        self.rollback_error = None;
        self.rollback_in_flight = Some((plan_id.to_string(), step_id.to_string()));
        true
    }

    pub fn finish_rollback(&mut self, result: Result<RollbackResult, String>) {
        self.rollback_in_flight = None;
        match result {
            Ok(result) => {
                self.rollback_result = Some(result);
                self.rollback_error = None;
            }
            Err(error) => self.rollback_error = Some(error),
        }
    }

    /// 应用 plan_update：仅当匹配计划且 version 严格递增。
    /// 返回 true 表示状态有变化（UI 需要重绘）。
    pub fn apply_plan_update(
        &mut self,
        plan_id: &str,
        status: &str,
        steps: &[(String, String)],
        version: u64,
    ) -> bool {
        let known_version = self.last_versions.get(plan_id).copied().unwrap_or(0);
        if version != 0 && version <= known_version {
            return false; // 版本围栏：过期推送丢弃
        }
        if version != 0 {
            self.last_versions.insert(plan_id.to_string(), version);
        }

        let Some(sel) = self.selected.as_mut() else {
            return false;
        };
        if sel.plan_id != plan_id {
            return false;
        }
        sel.last_version = sel.last_version.max(version);
        sel.status = parse_plan_status(status);
        sel.has_ws_status = true;
        for (step_id, st) in steps {
            sel.live_status
                .insert(step_id.clone(), parse_step_status(st));
        }
        true
    }

    /// REST 兜底全量拉取的权威校准。
    ///
    /// 对同一计划保留已收到的 WS live_status 和 last_version；REST detail 只更新
    /// 静态描述/步骤，不得清掉更新鲜的运行时信息。不同计划切换时从 last_versions
    /// 恢复版本围栏，避免旧版本事件倒灌。
    pub fn set_plan_detail(&mut self, detail: PlanDetail) {
        let plan_id = detail.plan_id.clone();
        if let Some(previous) = self.selected.take() {
            if previous.plan_id == plan_id {
                // REST detail 只更新静态详情；已有 live_status 由 WS 提供，
                // 不能把旧 REST 值伪装成更新鲜的运行态。
                let live_status = previous.live_status;
                let status = if previous.has_ws_status {
                    previous.status
                } else {
                    parse_plan_status(&detail.status)
                };
                let last_version = previous
                    .last_version
                    .max(self.last_versions.get(&plan_id).copied().unwrap_or(0));
                self.selected = Some(SelectedPlan {
                    plan_id,
                    status,
                    live_status,
                    detail,
                    last_version,
                    has_ws_status: previous.has_ws_status,
                });
                return;
            }
        }

        let last_version = self.last_versions.get(&plan_id).copied().unwrap_or(0);
        self.selected = Some(SelectedPlan {
            plan_id,
            status: parse_plan_status(&detail.status),
            live_status: HashMap::new(),
            detail,
            last_version,
            has_ws_status: false,
        });
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    fn design(id: &str, request: &str) -> Design {
        serde_json::from_value(serde_json::json!({
            "design_id": id,
            "user_request": request,
            "created_at": "2026-08-29T00:00:00Z",
            "part1": {
                "architecture": {"components": ["api"], "data_flow": ["client -> api"], "tech_stack": ["Rust"]},
                "difficulty": {"level": "medium", "reasoning": "several components"}
            },
            "part2": {
                "available_tools": [{"tool_id": "shell", "purpose": "run", "quality": "good"}],
                "missing_tools": [], "recommendations": ["add tests"]
            }
        }))
        .unwrap()
    }

    fn detail_with(plan_id: &str, status: &str, steps: &[(&str, &str)]) -> PlanDetail {
        let raw_steps: Vec<serde_json::Value> = steps
            .iter()
            .map(|(id, st)| {
                serde_json::json!({"step_id": id, "order": 1, "description": "d", "tool": "t", "status": st})
            })
            .collect();
        let raw = serde_json::json!({
            "plan_id": plan_id, "design_id": "d", "status": status,
            "segments": [{"segment_id": "s", "description": "seg", "steps": raw_steps}],
            "steps": raw_steps,
        });
        serde_json::from_value(raw).unwrap()
    }

    #[test]
    fn design_generation_enters_review_and_preserves_input() {
        let mut st = GuiState::default();
        st.input_text = " build API ".into();
        assert!(st.begin_design_generation());
        assert!(st.design_loading);
        st.design_generated(design("d1", "build API"));
        assert_eq!(st.mode, GuiMode::Review);
        assert_eq!(st.input_text, "build API");
        assert_eq!(st.current_design.as_ref().unwrap().design_id, "d1");
        assert_eq!(st.designs.len(), 1);
    }

    #[test]
    fn blank_feedback_is_rejected_without_a_design_action() {
        let mut st = GuiState::default();
        st.current_design = Some(design("d1", "request"));
        st.feedback_text = " \n\t".into();
        assert!(st.trimmed_feedback().is_none());
        assert!(st.begin_design_action());
        st.finish_design_action(Err("请输入非空反馈后提交".into()));
        assert!(!st.design_action_in_flight);
        assert_eq!(st.mode, GuiMode::Input);
        assert!(st.current_design.is_some());
    }

    #[test]
    fn revised_design_replaces_current_and_stays_in_review() {
        let mut st = GuiState::default();
        st.current_design = Some(design("d1", "request"));
        st.mode = GuiMode::Review;
        assert!(st.begin_design_action());
        st.finish_design_action(Ok(DesignApprovalResponse::Revised {
            design: design("d1", "revised request"),
        }));
        assert_eq!(st.mode, GuiMode::Review);
        assert_eq!(
            st.current_design.as_ref().unwrap().user_request,
            "revised request"
        );
        assert!(!st.design_action_in_flight);
    }

    #[test]
    fn ordinary_rejection_clears_design_and_returns_to_input() {
        let mut st = GuiState::default();
        st.current_design = Some(design("d1", "request"));
        st.mode = GuiMode::Review;
        assert!(st.begin_design_action());
        st.finish_design_action(Ok(DesignApprovalResponse::Rejected {
            message: "设计书已拒绝".into(),
        }));
        assert_eq!(st.mode, GuiMode::Input);
        assert!(st.current_design.is_none());
        assert_eq!(st.notice.as_deref(), Some("设计书已拒绝"));
    }

    #[test]
    fn approved_design_loads_plan_without_dropping_other_state() {
        let mut st = GuiState::default();
        st.current_design = Some(design("d1", "request"));
        st.token = "keep".into();
        st.plans.push(PlanSummary {
            plan_id: "old".into(),
            design_id: "d0".into(),
            created_at: "t".into(),
        });
        assert!(st.begin_design_action());
        st.finish_design_action(Ok(DesignApprovalResponse::Approved {
            plan: detail_with("p1", "Pending", &[]),
        }));
        assert_eq!(st.mode, GuiMode::Plan);
        assert!(st.current_design.is_none());
        assert_eq!(st.selected.as_ref().unwrap().plan_id, "p1");
        assert_eq!(st.token, "keep");
        assert_eq!(st.plans.len(), 1);
    }

    #[test]
    fn plan_update_applies_and_fences_versions() {
        let mut st = GuiState::default();
        st.set_plan_detail(detail_with("p1", "Pending", &[("s1", "Pending")]));
        assert_eq!(st.selected.as_ref().unwrap().status, PlanStatus::Pending);

        // 新版本应用
        assert!(st.apply_plan_update("p1", "Running", &[("s1".into(), "Running".into())], 5));
        assert_eq!(st.selected.as_ref().unwrap().status, PlanStatus::Running);
        assert_eq!(
            st.selected.as_ref().unwrap().step_status("s1", "Pending"),
            StepStatus::Running
        );

        // 旧版本被围栏丢弃
        assert!(!st.apply_plan_update("p1", "Failed", &[("s1".into(), "Failed".into())], 4));
        assert_eq!(
            st.selected.as_ref().unwrap().step_status("s1", "Pending"),
            StepStatus::Running
        );

        // 计划不匹配则忽略，但版本仍记账，切换后仍能围栏
        assert!(!st.apply_plan_update("other", "Failed", &[], 9));
        assert_eq!(st.last_versions.get("other"), Some(&9));
    }

    #[test]
    fn detail_refresh_preserves_live_status_and_version() {
        let mut st = GuiState::default();
        st.set_plan_detail(detail_with("p1", "Pending", &[("s1", "Pending")]));
        assert!(st.apply_plan_update("p1", "Running", &[("s1".into(), "Running".into())], 7));
        st.set_plan_detail(detail_with("p1", "Pending", &[("s1", "Pending")]));
        let selected = st.selected.as_ref().unwrap();
        assert_eq!(selected.status, PlanStatus::Running);
        assert_eq!(selected.last_version, 7);
        assert_eq!(selected.step_status("s1", "Pending"), StepStatus::Running);
    }

    #[test]
    fn progress_excludes_rolled_back() {
        let mut st = GuiState::default();
        st.set_plan_detail(detail_with(
            "p1",
            "RolledBack",
            &[("s1", "RolledBack"), ("s2", "Success"), ("s3", "Skipped")],
        ));
        assert_eq!(st.selected.as_ref().unwrap().progress(), (2, 3));
    }

    #[test]
    fn logs_are_bounded_and_keep_newest_lines() {
        let mut st = GuiState::default();
        for i in 0..1500 {
            st.push_log("info", format!("line {i}"));
        }
        assert_eq!(st.logs.len(), 1000);
        assert!(st.logs[0].message.ends_with("500"));
        assert!(st.logs[999].message.ends_with("1499"));
    }

    fn approval(id: &str, plan_id: &str) -> ApprovalRequest {
        serde_json::from_value(serde_json::json!({
            "approval_id": id, "plan_id": plan_id, "step_id": "s1",
            "tool_id": "tool", "instruction": "inspect", "inputs": {}, "created_at": id
        }))
        .unwrap()
    }

    #[test]
    fn approval_resolution_matches_only_its_id_and_failed_action_keeps_card() {
        let mut st = GuiState::default();
        st.apply_approval_request(approval("a1", "p1"));
        st.apply_approval_request(approval("a2", "p1"));
        assert!(st.begin_approval("a1"));
        st.finish_approval("a1", Err("后端拒绝".into()));
        assert_eq!(st.pending_approvals.len(), 2);
        assert!(st.approvals_error.is_some());
        assert!(st.apply_approval_resolved(&ApprovalResolved {
            approval_id: "a2".into(),
            approved: true
        }));
        assert_eq!(
            st.pending_approvals
                .iter()
                .map(|a| a.approval_id.as_str())
                .collect::<Vec<_>>(),
            vec!["a1"]
        );
    }

    fn audit(
        id: i64,
        plan: &str,
        success: Option<i64>,
        blocked: i64,
        reason: Option<&str>,
    ) -> AuditLogEntry {
        serde_json::from_value(serde_json::json!({
            "audit_id": id, "timestamp": "2026", "plan_id": plan, "step_id": null,
            "tool_id": "shell", "instruction": "run", "inputs": "{}", "success": success,
            "blocked": blocked, "block_reason": reason, "actor": "user"
        }))
        .unwrap()
    }

    #[test]
    fn audit_filtering_and_result_classification_are_stable() {
        let mut st = GuiState::default();
        st.audit_logs = vec![
            audit(1, "p1", Some(1), 0, None),
            audit(2, "p2", Some(0), 0, None),
            audit(3, "p3", None, 1, Some("policy")),
        ];
        assert_eq!(
            st.audit_logs[0].result(),
            crate::types::AuditResult::Success
        );
        assert_eq!(st.audit_logs[1].result(), crate::types::AuditResult::Failed);
        assert_eq!(
            st.audit_logs[2].result(),
            crate::types::AuditResult::Blocked
        );
        st.audit_search = "policy".into();
        assert_eq!(st.filtered_audit_logs().len(), 1);
    }

    #[test]
    fn rollback_state_requires_confirmation_and_keeps_errors_local() {
        let mut st = GuiState::default();
        st.request_rollback("p1".into(), "s1".into());
        assert_eq!(st.rollback_confirmation, Some(("p1".into(), "s1".into())));
        assert!(st.begin_rollback("p1", "s1"));
        st.finish_rollback(Err("回滚失败".into()));
        assert!(st.rollback_in_flight.is_none());
        assert_eq!(st.rollback_error.as_deref(), Some("回滚失败"));
    }
}
